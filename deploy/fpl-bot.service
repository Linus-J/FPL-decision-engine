[Unit]
Description=FPL decision engine — builds the gameweek decision (never submits)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/linus/Projects/FPL-26-27-bot
ExecStart=/bin/sh -c '/home/linus/.local/bin/uv run python scripts/run_agent.py; /home/linus/.local/bin/uv run python scripts/run_simulations.py'
EnvironmentFile=/home/linus/Projects/FPL-26-27-bot/.env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpl-bot

[Install]
WantedBy=default.target

# Your FPL team ID, from the URL on the FPL site. Used to read your squad.
FPL_TEAM_ID=12345678

# An absolute path is clearest. A relative one resolves against the repo root,
# not the working directory -- a relative DB_PATH read against the cwd once
# cost this project five weeks of scheduled runs against a stale database.
DB_PATH=fpl_bot_v2.db

# Odds for team-goal lambda. Without it every fixture falls back to the fitted
# strength model, which is measurably worse for the gameweek about to be played.
THE_ODDS_API_KEY=your_free_key_from_the-odds-api.com

# Press-conference availability signals. 'test' is the free low-volume key.
GUARDIAN_KEY=test

TELEGRAM_BOT_TOKEN=optional
TELEGRAM_CHAT_ID=optional

# FPL_EMAIL, FPL_PASSWORD and DRY_RUN were removed on 2026-08-18 along with the
# submission path. This engine cannot enter a team for you, so it needs no
# account credentials and has no live mode to switch on. Leaving them in an old
# .env is harmless; they are ignored.
